{
  "name": "fourthwall-final",
  "version": "1.0.0",
  "description": "The Fourth Wall — Branding & Digital Agency Website",
  "main": "scripts/server.js",
  "scripts": {
    "start": "node scripts/server.js",
    "test": "node --test tests/*.test.js",
    "dev": "node scripts/server.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "dev:cloudflare": "wrangler dev --config cloudflare/wrangler.toml",
    "deploy:cloudflare": "wrangler deploy --config cloudflare/wrangler.toml"
  },
  "keywords": [
    "agency",
    "portfolio",
    "branding",
    "digital"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.0.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.43.0"
  }
}
